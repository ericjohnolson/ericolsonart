<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Peeping Tom is a publication series created by Evelina Miropolsky and Eric John Olson."
    />

    <title>Peeping Tom</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Red+Hat+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="theme-color" content="#ccccff" />
  </head>

  <body>
    <div class="wrap">
      <img src="/images/peepingtom/tomAndJerryPeep.png" alt="Peeping Tom" class="logo" />
      <p>
        Peeping Tom is a publication series created by Evelina Miropolsky and Eric John Olson,
        based on a walking and archival practice by Evelina. Please reach out to
        <a href="mailto:miropoem@gmail.com">miropoem@gmail.com</a> with any questions or submissions
        of your own peeps!
      </p>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #ccccff;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 100px 24px;
    text-align: center;
  }

  .logo {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
    margin: 0 auto 40px;
  }

  p {
    font-family: 'Red Hat Mono', monospace;
    font-size: 1.1em;
    line-height: 1.6;
    color: #33334d;
    margin: 0;
  }

  a {
    color: #33334d;
    text-decoration: underline;
  }

  a:hover,
  a:focus {
    text-decoration: none;
  }
</style>
